flowchart TD
  subgraph IOS[用户功能 · iPhone]
    O[Onboarding]
    T[Today Agenda]
    P[Projects · Learning Plan]
    S[Quick Log · Timer · Routine Player]
    EVID[Proof · Library]
    R[Weekly / Stage Review]
    CAL[Calendar · Schedule Draft]
  end

  subgraph WEB[用户功能 · Web Workspace]
    DEMO[Demo mode<br/>deterministic fixtures]
    REAL[Real Journal mode<br/>read + guarded write]
    SYNC[Sync & Conflicts]
    RD[Recoverable Drafts]
  end

  subgraph CORE[共享契约与规则]
    VM[界面状态协调]
    J[Project·Plan·Session·Proof·Trail 规则]
    PLAN[Plan Revision · Revision Guard]
    RV[Readiness · Review Decision · 显式应用]
    MERGE[Sync Merge · no hidden LWW]
    STORE[Journal Store / CloudKit mapper]
    A[附件管理]
    EX[完整 Bundle 导出]
  end

  subgraph DATA[本地存储与外部边界]
    DB[(SwiftData 正常存储)]
    JSON[(JSON Store 降级)]
    CK[(CloudKit private zone)]
    FILES[(本地附件)]
    DRAFTDB[(IndexedDB / localStorage<br/>unfinished drafts only)]
    PREFS[(偏好设置与 Keychain)]
    EXPORTS[(Exports 目录)]
    AI[可选 AI / Support Service]
  end

  O --> VM
  T --> VM
  P --> VM
  S --> VM
  EVID --> VM
  R --> VM
  CAL --> VM
  DEMO --> VM
  REAL --> VM
  VM --> J
  VM --> PLAN
  VM --> RV
  VM --> A
  VM --> EX
  REAL -->|read / atomic write| CK
  REAL --> MERGE
  MERGE --> SYNC
  RD --> DRAFTDB
  J --> STORE
  STORE --> DB
  STORE -.初始化失败时.-> JSON
  STORE -.private sync.-> CK
  PLAN --> J
  RV --> J
  RV --> PREFS
  RV -.配置完整时.-> AI
  A --> FILES
  EX --> FILES
  EX --> EXPORTS
